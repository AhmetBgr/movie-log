@page "/advanced-search"
@using System.Globalization
@using System.Text
@using System.Net.Http.Json
@using System.Text.Json.Serialization
@using MyPrivateWatchlist.Models
@using MyPrivateWatchlist.Components
@inject HttpClient Http
@inject MyPrivateWatchlist.Services.WatchlistService WatchlistSvc
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Advanced Search</PageTitle>

<div class="page-shell">
    <div class="as-body">

        <!-- ── Filter sidebar ───────────────────────────────────── -->
        <aside class="as-sidebar @(IsMobile ? "mobile" : "desktop") @(IsMobile && _showFiltersMobile ? "open" : "")">
            <div class="as-filter-scroll">

                <!-- Media type -->
                <div class="as-section">
                    <div class="as-label expanded">Title Type</div>
                    <div class="as-section-body">
                        <div class="btn-group w-100" role="group">
                            <input type="radio" class="btn-check" name="as-media" id="as-media-movie"
                                   checked="@(_mediaType == "movie")" @onclick='() => SetMediaType("movie")'>
                            <label class="btn btn-outline-secondary" for="as-media-movie">
                                <i class="bi bi-film me-1"></i>Movies
                            </label>
                            <input type="radio" class="btn-check" name="as-media" id="as-media-tv"
                                   checked="@(_mediaType == "tv")" @onclick='() => SetMediaType("tv")'>
                            <label class="btn btn-outline-secondary" for="as-media-tv">
                                <i class="bi bi-tv me-1"></i>TV
                            </label>
                        </div>
                    </div>
                </div>

                <!-- Genres -->
                <div class="as-section">
                    <div class="as-label expanded">Genres</div>
                    <div class="as-section-body">
                        @if (CurrentGenres.Count == 0)
                        {
                            <div class="text-secondary small">Loading genres…</div>
                        }
                        else
                        {
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="text-secondary" style="font-size:0.65rem;">Matching Logic:</span>
                                <div class="btn-group btn-group-sm" role="group">
                                    <input type="radio" class="btn-check" name="as-genlogic" id="as-glany"
                                           checked="@(!_genreAll)" @onclick="() => _genreAll = false">
                                    <label class="btn btn-outline-secondary px-3" for="as-glany" style="font-size:0.6rem;font-weight:700;">ANY</label>
                                    <input type="radio" class="btn-check" name="as-genlogic" id="as-glall"
                                           checked="@_genreAll" @onclick="() => _genreAll = true">
                                    <label class="btn btn-outline-secondary px-2" for="as-glall" style="font-size:0.55rem;font-weight:700;">ALL</label>
                                </div>
                            </div>
                            <div class="text-center mb-2" style="font-size:0.62rem;color:#94a3b8;">
                                Click once to <b>Include</b>, twice to <b>Exclude</b>
                            </div>
                            <div class="as-genre-grid">
                                @foreach (var g in CurrentGenres)
                                {
                                    var state = GetGenreState(g.Id);
                                    <button class="as-genre-btn @(state == 1 ? "as-genre-inc" : state == 2 ? "as-genre-exc" : "")"
                                            @onclick="() => CycleGenre(g.Id)">
                                        @if (state == 1) { <i class="bi bi-plus-circle-fill me-1"></i> }
                                        @if (state == 2) { <i class="bi bi-dash-circle-fill me-1"></i> }
                                        @g.Name
                                    </button>
                                }
                            </div>
                        }
                    </div>
                </div>

                <!-- Release & rating -->
                <div class="as-section">
                    <div class="as-label expanded">Release & Rating</div>
                    <div class="as-section-body">
                        <label class="as-sub-label">Release Year</label>
                        <div class="d-flex gap-2 mb-3">
                            <input type="number" class="form-control form-control-sm as-input shadow-none" placeholder="From" @bind="_minYear" />
                            <input type="number" class="form-control form-control-sm as-input shadow-none" placeholder="To" @bind="_maxYear" />
                        </div>

                        <label class="as-sub-label">TMDB Rating (0–10)</label>
                        <div class="d-flex gap-2 mb-3">
                            <input type="number" class="form-control form-control-sm as-input shadow-none" placeholder="Min" step="0.5" min="0" max="10" @bind="_minRating" />
                            <input type="number" class="form-control form-control-sm as-input shadow-none" placeholder="Max" step="0.5" min="0" max="10" @bind="_maxRating" />
                        </div>

                        <label class="as-sub-label">Minimum Votes</label>
                        <input type="number" class="form-control form-control-sm as-input shadow-none" placeholder="e.g. 50" min="0" @bind="_minVotes" />
                    </div>
                </div>

                <!-- Library status -->
                <div class="as-section">
                    <div class="as-label expanded">Library</div>
                    <div class="as-section-body">
                        <div class="as-lib-grid">
                            <button class="as-lib-filter-btn @(_libFilter == LibFilter.All ? "lfb-active" : "")"
                                    @onclick="() => SetLibFilter(LibFilter.All)">
                                <i class="bi bi-asterisk me-1"></i>Show All
                            </button>
                            <button class="as-lib-filter-btn @(_libFilter == LibFilter.HideWatched ? "lfb-active" : "")"
                                    @onclick="() => SetLibFilter(LibFilter.HideWatched)">
                                <i class="bi bi-eye-slash me-1"></i>Hide Watched
                            </button>
                            <button class="as-lib-filter-btn @(_libFilter == LibFilter.NotInLibrary ? "lfb-active" : "")"
                                    @onclick="() => SetLibFilter(LibFilter.NotInLibrary)">
                                <i class="bi bi-stars me-1"></i>Not in Library
                            </button>
                        </div>
                    </div>
                </div>

            </div>

            <div class="as-filter-footer">
                <div class="d-grid gap-2">
                    <button class="btn btn-primary py-2 fw-bold shadow-sm" @onclick="ApplyAsync" disabled="@_isLoading">
                        <i class="bi bi-search me-1"></i> Search
                    </button>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="ResetFilters">
                        <i class="bi bi-arrow-counterclockwise me-1"></i> Reset
                    </button>
                </div>
            </div>
        </aside>

        @if (IsMobile && _showFiltersMobile)
        {
            <div class="as-backdrop" @onclick="() => _showFiltersMobile = false"></div>
        }

        <!-- ── Results ──────────────────────────────────────────── -->
        <div class="as-results page-content scroll-y">

            <div class="as-toolbar">
                @if (IsMobile)
                {
                    <button class="btn btn-sm btn-outline-secondary flex-shrink-0" @onclick="() => _showFiltersMobile = true">
                        <i class="bi bi-sliders me-1"></i> Filters
                    </button>
                }

                <!-- Sort buttons (Library-style toggles) -->
                <div class="as-sort-group">
                    <span class="as-sort-label">Sort:</span>
                    <button class="tb-btn tb-btn-sort @(_sortField == "popularity" ? "sorted" : "")"
                            @onclick='() => ToggleSort("popularity", true)'>
                        <i class="bi bi-fire"></i>
                        <span class="tb-label">Popular</span>
                    </button>
                    <button class="tb-btn tb-btn-sort @(_sortField == "title" ? "sorted" : "")"
                            @onclick='() => ToggleSort("title", false)'>
                        <i class="bi @(_sortField == "title" ? (_sortDesc ? "bi-sort-alpha-up-alt" : "bi-sort-alpha-down") : "bi-sort-alpha-down")"></i>
                        <span class="tb-label">Title</span>
                    </button>
                    <button class="tb-btn tb-btn-sort @(_sortField == "year" ? "sorted" : "")"
                            @onclick='() => ToggleSort("year", true)'>
                        <i class="bi @(_sortField == "year" ? (_sortDesc ? "bi-sort-numeric-up-alt" : "bi-sort-numeric-down") : "bi-sort-numeric-down")"></i>
                        <span class="tb-label">Year</span>
                    </button>
                    <button class="tb-btn tb-btn-sort @(_sortField == "rating" ? "sorted" : "")"
                            @onclick='() => ToggleSort("rating", true)'>
                        <i class="bi bi-star"></i>
                        <span class="tb-label">Rating</span>
                    </button>
                </div>

                <span class="as-result-count ms-auto">
                    @if (_hasSearched && !_isLoading)
                    {
                        <text>@VisibleResults.Count shown</text>
                    }
                </span>
            </div>

            @if (string.IsNullOrWhiteSpace(WatchlistSvc.TmdbApiKey))
            {
                <div class="as-state-wrap">
                    <div class="alert alert-warning mb-0">
                        TMDB API key is missing. Please add it in <a href="configure">Configure</a>.
                    </div>
                </div>
            }
            else if (_isLoading)
            {
                <div class="as-state-wrap">
                    <div class="spinner-border text-secondary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            }
            else if (!string.IsNullOrEmpty(_error))
            {
                <div class="as-state-wrap">
                    <div class="alert alert-danger mb-0 d-inline-flex flex-column align-items-start gap-2">
                        <span>@_error</span>
                        <button class="btn btn-sm btn-outline-danger" @onclick="ApplyAsync">
                            <i class="bi bi-arrow-clockwise me-1"></i>Retry
                        </button>
                    </div>
                </div>
            }
            else if (!_hasSearched)
            {
                <div class="as-state-wrap">
                    <div class="text-center text-secondary opacity-75">
                        <i class="bi bi-search fs-3 d-block mb-2"></i>
                        <span>Set your filters and press <b>Search</b> to browse the TMDB catalog.</span>
                    </div>
                </div>
            }
            else if (!VisibleResults.Any())
            {
                <div class="as-state-wrap">
                    <div class="text-center text-secondary opacity-75">
                        <i class="bi bi-film fs-3 d-block mb-2"></i>
                        <span>No titles match these filters.</span>
                    </div>
                </div>
            }
            else
            {
                <div class="table-wrap mx-auto p-2" style="max-width: 690px;">
                    <div class="as-card-frame">
                        <div class="row row-cols-1 g-0">
                            @foreach (var item in VisibleResults)
                            {
                                var libItem = FindLibraryItem(item);
                                var cardItem = libItem ?? new WatchlistItem
                                {
                                    Title = item.DisplayTitle,
                                    OriginalTitle = item.DisplayOriginalTitle,
                                    TitleType = item.MediaType == "tv" ? "TV Series" : "Movie",
                                    Year = GetYear(item),
                                    Genres = GetGenreNamesFromIds(item.GenreIds),
                                    PosterPath = item.PosterPath,
                                    Overview = item.Overview,
                                    VoteAverage = item.VoteAverage,
                                    ImdbId = $"{(item.MediaType ?? "movie")}-{item.Id}",
                                    TmdbId = item.Id
                                };

                                <div class="col as-card-row" @key="@($"{item.MediaType}-{item.Id}")">
                                    <MovieCard Item="cardItem"
                                               ShowRating="@(libItem?.Rating20.HasValue == true || libItem?.UserRating.HasValue == true)"
                                               OnClick="@(_ => WatchlistSvc.ShowDetailsAsync(item))">
                                        <Badges>
                                            @if (libItem != null)
                                            {
                                                <span class="badge as-lib-badge @GetLibraryBadgeClass(libItem.Status)">
                                                    @GetLibraryStatusText(libItem.Status)
                                                </span>
                                            }
                                        </Badges>
                                    </MovieCard>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="as-loadmore-wrap">
                    @if (!string.IsNullOrEmpty(_loadMoreError))
                    {
                        <div class="alert alert-danger py-2 px-3 mb-0 d-inline-flex align-items-center gap-2">
                            <span>@_loadMoreError</span>
                            <button class="btn btn-sm btn-outline-danger" @onclick="LoadMoreAsync">
                                <i class="bi bi-arrow-clockwise me-1"></i>Retry
                            </button>
                        </div>
                    }
                    else if (_isLoadingMore)
                    {
                        <button class="btn btn-outline-secondary" disabled>
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            Loading more...
                        </button>
                    }
                    else if (HasMore)
                    {
                        <button class="btn btn-outline-secondary" @onclick="LoadMoreAsync">
                            <i class="bi bi-plus-lg me-1"></i>Load @BatchSize more
                        </button>
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    private const int BatchSize = 10;

    private enum LibFilter { All, HideWatched, NotInLibrary }

    // ── Filter state ──
    private string _mediaType = "movie";
    private readonly HashSet<int> _includedGenres = new();
    private readonly HashSet<int> _excludedGenres = new();
    private bool _genreAll = false; // false = ANY (OR), true = ALL (AND)
    private int? _minYear;
    private int? _maxYear;
    private double? _minRating;
    private double? _maxRating;
    private int? _minVotes = 50;
    private LibFilter _libFilter = LibFilter.All;

    // ── Sort state (Library-style) ──
    private string _sortField = "popularity"; // popularity | title | year | rating
    private bool _sortDesc = true;

    // ── Genre lists ──
    private List<TmdbGenre> _movieGenres = new();
    private List<TmdbGenre> _tvGenres = new();
    private List<TmdbGenre> CurrentGenres => _mediaType == "tv" ? _tvGenres : _movieGenres;

    // ── Results state ──
    // _buffer holds every raw item fetched from TMDB (20 per page); we reveal BatchSize at a time client-side.
    private readonly List<TmdbSearchResultItem> _buffer = new();
    private readonly HashSet<string> _bufferKeys = new();
    private int _revealCount = BatchSize;
    private bool _hasSearched;
    private bool _isLoading;
    private bool _isLoadingMore;
    private string? _error;
    private string? _loadMoreError;
    private int _currentPage;
    private int _totalPages;

    private List<TmdbSearchResultItem> FilteredBuffer => _buffer.Where(PassesLibraryFilter).ToList();
    private List<TmdbSearchResultItem> VisibleResults => FilteredBuffer.Take(_revealCount).ToList();
    private bool HasMore => _hasSearched && !_isLoading && !_isLoadingMore &&
                            (FilteredBuffer.Count > _revealCount || _currentPage < _totalPages);

    private bool IsMobile;
    private bool _showFiltersMobile;

    protected override void OnInitialized()
    {
        WatchlistSvc.OnStateChanged += HandleStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try { IsMobile = await JS.InvokeAsync<bool>("uiHelpers.isMobile"); } catch { }
            await LoadGenresAsync();
            StateHasChanged();
        }
    }

    private async Task LoadGenresAsync()
    {
        var apiKey = WatchlistSvc.TmdbApiKey;
        if (string.IsNullOrWhiteSpace(apiKey)) return;
        try
        {
            var movie = await Http.GetFromJsonAsync<TmdbGenreListResponse>(
                $"https://api.themoviedb.org/3/genre/movie/list?api_key={Uri.EscapeDataString(apiKey)}");
            var tv = await Http.GetFromJsonAsync<TmdbGenreListResponse>(
                $"https://api.themoviedb.org/3/genre/tv/list?api_key={Uri.EscapeDataString(apiKey)}");

            if (movie?.Genres != null) _movieGenres = movie.Genres.OrderBy(g => g.Name).ToList();
            if (tv?.Genres != null) _tvGenres = tv.Genres.OrderBy(g => g.Name).ToList();
        }
        catch { /* genres optional; user can still filter by other fields */ }
    }

    private void SetMediaType(string mediaType)
    {
        if (_mediaType == mediaType) return;
        _mediaType = mediaType;
        // Genre IDs differ between movie and TV lists, so clear selections.
        _includedGenres.Clear();
        _excludedGenres.Clear();
    }

    private int GetGenreState(int id)
    {
        if (_includedGenres.Contains(id)) return 1;
        if (_excludedGenres.Contains(id)) return 2;
        return 0;
    }

    private void CycleGenre(int id)
    {
        var state = GetGenreState(id);
        if (state == 0) { _includedGenres.Add(id); }
        else if (state == 1) { _includedGenres.Remove(id); _excludedGenres.Add(id); }
        else { _excludedGenres.Remove(id); }
    }

    private void SetLibFilter(LibFilter f)
    {
        _libFilter = f;
        // Client-side filter — re-reveal from the top; top up the buffer if the filter thinned it out.
        _revealCount = BatchSize;
        if (_hasSearched) _ = EnsureRevealFilledAsync();
    }

    private async Task ToggleSort(string field, bool defaultDesc)
    {
        if (_sortField == field) _sortDesc = !_sortDesc;
        else { _sortField = field; _sortDesc = defaultDesc; }

        // Sorting is server-side on TMDB, so re-run the search if one is active.
        if (_hasSearched) await ApplyAsync();
    }

    private string BuildSortBy()
    {
        var dir = _sortDesc ? "desc" : "asc";
        var dateField = _mediaType == "tv" ? "first_air_date" : "primary_release_date";
        return _sortField switch
        {
            "title" => $"original_title.{dir}",
            "year" => $"{dateField}.{dir}",
            "rating" => $"vote_average.{dir}",
            _ => $"popularity.{dir}"
        };
    }

    private bool PassesLibraryFilter(TmdbSearchResultItem item)
    {
        if (_libFilter == LibFilter.All) return true;
        var lib = FindLibraryItem(item);
        return _libFilter switch
        {
            LibFilter.HideWatched => lib?.Status != WatchlistStatus.Watched,
            LibFilter.NotInLibrary => lib == null,
            _ => true
        };
    }

    private void ResetFilters()
    {
        _includedGenres.Clear();
        _excludedGenres.Clear();
        _genreAll = false;
        _minYear = null;
        _maxYear = null;
        _minRating = null;
        _maxRating = null;
        _minVotes = 50;
        _libFilter = LibFilter.All;
        _sortField = "popularity";
        _sortDesc = true;
    }

    private async Task ApplyAsync()
    {
        if (string.IsNullOrWhiteSpace(WatchlistSvc.TmdbApiKey)) return;
        _showFiltersMobile = false;
        _isLoading = true;
        _error = null;
        _loadMoreError = null;
        _hasSearched = true;
        _buffer.Clear();
        _bufferKeys.Clear();
        _currentPage = 0;
        _totalPages = 1;
        _revealCount = BatchSize;
        StateHasChanged();

        try
        {
            await FetchNextPageAsync();
            await EnsureRevealFilledAsync();
        }
        catch (Exception ex)
        {
            _error = $"Search failed. {ex.Message}";
            _buffer.Clear();
            _bufferKeys.Clear();
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadMoreAsync()
    {
        if (_isLoading || _isLoadingMore || !HasMore) return;
        _isLoadingMore = true;
        _loadMoreError = null;
        StateHasChanged();

        try
        {
            _revealCount += BatchSize;
            await EnsureRevealFilledAsync();
        }
        catch (Exception ex)
        {
            _loadMoreError = $"Could not load more. {ex.Message}";
        }
        finally
        {
            _isLoadingMore = false;
            StateHasChanged();
        }
    }

    // Fetch more TMDB pages until we have enough filtered items to satisfy the current reveal count.
    private async Task EnsureRevealFilledAsync()
    {
        while (FilteredBuffer.Count < _revealCount && _currentPage < _totalPages)
        {
            await FetchNextPageAsync();
        }
    }

    private async Task FetchNextPageAsync()
    {
        var page = _currentPage + 1;
        var url = BuildDiscoverUrl(page);
        var response = await Http.GetFromJsonAsync<DiscoverApiResponse>(url);
        var items = response?.Results ?? new List<TmdbSearchResultItem>();
        foreach (var item in items)
        {
            item.MediaType = _mediaType; // /discover does not return media_type
            var key = $"{item.MediaType}-{item.Id}";
            if (_bufferKeys.Add(key)) _buffer.Add(item);
        }
        _currentPage = response?.Page ?? page;
        _totalPages = Math.Min(500, Math.Max(1, response?.TotalPages ?? page));
    }

    private string BuildDiscoverUrl(int page)
    {
        var apiKey = WatchlistSvc.TmdbApiKey;
        var sb = new StringBuilder();
        sb.Append($"https://api.themoviedb.org/3/discover/{_mediaType}?api_key={Uri.EscapeDataString(apiKey)}");
        sb.Append("&include_adult=false");
        sb.Append($"&page={page}");
        sb.Append($"&sort_by={BuildSortBy()}");

        if (_includedGenres.Any())
        {
            var sep = _genreAll ? "," : "|"; // comma = AND (ALL), pipe = OR (ANY)
            sb.Append($"&with_genres={Uri.EscapeDataString(string.Join(sep, _includedGenres))}");
        }
        if (_excludedGenres.Any())
        {
            sb.Append($"&without_genres={Uri.EscapeDataString(string.Join(",", _excludedGenres))}");
        }

        var dateField = _mediaType == "tv" ? "first_air_date" : "primary_release_date";
        if (_minYear.HasValue) sb.Append($"&{dateField}.gte={_minYear}-01-01");
        if (_maxYear.HasValue) sb.Append($"&{dateField}.lte={_maxYear}-12-31");

        if (_minRating.HasValue) sb.Append($"&vote_average.gte={_minRating.Value.ToString(CultureInfo.InvariantCulture)}");
        if (_maxRating.HasValue) sb.Append($"&vote_average.lte={_maxRating.Value.ToString(CultureInfo.InvariantCulture)}");
        if (_minVotes.HasValue && _minVotes > 0) sb.Append($"&vote_count.gte={_minVotes}");

        return sb.ToString();
    }

    private string GetGenreNamesFromIds(List<int>? ids)
    {
        if (ids == null || ids.Count == 0) return "";
        var map = CurrentGenres.ToDictionary(g => g.Id, g => g.Name);
        return string.Join(", ", ids.Select(id => map.TryGetValue(id, out var n) ? n : "").Where(n => !string.IsNullOrEmpty(n)));
    }

    private static string GetYear(TmdbSearchResultItem item)
    {
        var date = item.DisplayDate;
        return date.Length >= 4 ? date[..4] : date;
    }

    private WatchlistItem? FindLibraryItem(TmdbSearchResultItem item)
    {
        var year = GetYear(item);
        return WatchlistSvc.Items.FirstOrDefault(i =>
            i.Title.Equals(item.DisplayTitle, StringComparison.OrdinalIgnoreCase) &&
            (year == "Unknown Date" || i.Year.Contains(year, StringComparison.OrdinalIgnoreCase)));
    }

    private static string GetLibraryStatusText(WatchlistStatus status) => status switch
    {
        WatchlistStatus.Pending => "In Watchlist",
        WatchlistStatus.Watching => "Watching",
        WatchlistStatus.Watched => "Watched",
        _ => "In Library"
    };

    private static string GetLibraryBadgeClass(WatchlistStatus status) => status switch
    {
        WatchlistStatus.Pending => "as-lib-pending",
        WatchlistStatus.Watching => "as-lib-watching",
        WatchlistStatus.Watched => "as-lib-watched",
        _ => "as-lib-pending"
    };

    private void HandleStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        WatchlistSvc.OnStateChanged -= HandleStateChanged;
    }

    private sealed class DiscoverApiResponse
    {
        [JsonPropertyName("page")]
        public int Page { get; set; }

        [JsonPropertyName("total_pages")]
        public int TotalPages { get; set; }

        [JsonPropertyName("results")]
        public List<TmdbSearchResultItem> Results { get; set; } = new();
    }
}

<style>
    .as-body {
        display: flex;
        flex-direction: row;
        height: 100%;
        overflow: hidden;
    }

    .as-results {
        flex: 1 1 auto;
        min-width: 0;
    }

    .as-toolbar {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px 14px;
        position: sticky;
        top: 0;
        z-index: 11;
        background: #fff;
        border-bottom: 1px solid #e8eaed;
        min-height: 48px;
        flex-wrap: wrap;
    }

    .as-sort-group {
        display: flex;
        align-items: center;
        gap: 4px;
        flex-wrap: wrap;
    }

    .as-sort-label {
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: #94a3b8;
        margin-right: 2px;
    }

    .as-result-count {
        font-size: 0.78rem;
        color: #64748b;
        font-weight: 600;
        white-space: nowrap;
