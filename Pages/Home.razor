                                @if (RatedCount > 0)
                                {
                                    var modalMaxRating = RatingDistribution.Max(x => x.Count);
                                    <div class="home-histogram" role="group" aria-label="Expanded rating distribution">
                                        @foreach (var bucket in RatingDistribution)
                                        {
                                            var height = modalMaxRating > 0 ? bucket.Count * 100d / modalMaxRating : 0;
                                            <button class="home-histogram-column cursor-pointer" title="@bucket.Label: @bucket.Count titles" disabled="@(bucket.Count == 0)" @onclick="() => OpenRatingRange(bucket.Lower, bucket.Upper)">
                                                <span class="home-histogram-count">@(bucket.Count > 0 ? bucket.Count.ToString() : "")</span>
                                                <span class="home-histogram-track"><span class="home-histogram-fill" style="height:@CssPercent(height);background:@Visuals.GetRatingColor(bucket.Upper);"></span></span>
                                                <span class="home-histogram-label">@bucket.ShortLabel</span>
