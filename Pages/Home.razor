        <div class="home-stat-card mb-4">
            <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
                <div>
                    <h2 class="home-card-title"><i class="bi bi-grid-1x2-fill me-2" style="color:#8b5cf6;"></i>Library profile</h2>
                    <div class="home-card-subtitle">A compact view of the release eras, runtimes, and title types you have watched.</div>
                </div>
                <div class="d-flex flex-column align-items-lg-end gap-2">
                    <div class="home-profile-tabs" role="tablist" aria-label="Library profile view">
                        <button role="tab" aria-selected="@(_profileView == "decades")" class="home-profile-tab @(_profileView == "decades" ? "active" : "")" @onclick='() => _profileView = "decades"'>Decades</button>
                        <button role="tab" aria-selected="@(_profileView == "runtime")" class="home-profile-tab @(_profileView == "runtime" ? "active" : "")" @onclick='() => _profileView = "runtime"'>Runtime</button>
                        <button role="tab" aria-selected="@(_profileView == "types")" class="home-profile-tab @(_profileView == "types" ? "active" : "")" @onclick='() => _profileView = "types"'>Title type</button>
                    </div>
                    <button type="button" class="home-see-more" @onclick='() => OpenExpandedStats(StatsSection.Profile)'>
                        See more <i class="bi bi-arrows-angle-expand" aria-hidden="true"></i>
                    </button>
                </div>
            </div>

            @if (CurrentProfileDistribution.Any())
            {
                var maxProfile = CurrentProfileDistribution.Max(x => x.Value);
                <div class="home-profile-grid">
                    @foreach (var entry in CurrentProfileDistribution)
                    {
                        <div class="home-profile-row" title="@entry.Key: @entry.Value watched">
                            <span class="home-profile-label">@entry.Key</span>
                            <div class="home-progress-track"><div class="home-progress-fill" style="width:@CssPercent(entry.Value * 100d / maxProfile);background:linear-gradient(90deg,#a78bfa,#7c3aed);"></div></div>
                            <span class="home-profile-count">@entry.Value</span>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="home-empty">No data is available for this view.</div>
            }
        </div>

        @if (_expandedSection.HasValue)
        {
            <div class="home-stats-modal-backdrop"
                 role="presentation"
                 @onclick="CloseExpandedStats"
                 @onkeydown="HandleModalKeyDown">
                <section class="home-stats-modal"
                         role="dialog"
                         aria-modal="true"
                         aria-labelledby="expanded-stats-title"
                         tabindex="-1"
                         @onclick:stopPropagation="true"
                         @onkeydown="HandleModalKeyDown">
                    <header class="home-stats-modal-header">
                        <div>
                            <h2 id="expanded-stats-title" class="home-card-title fs-5">@GetExpandedTitle(_expandedSection.Value)</h2>
                            <div class="home-card-subtitle">@GetExpandedSubtitle(_expandedSection.Value)</div>
                        </div>
                        <button type="button" class="home-modal-close" aria-label="Close expanded statistics" autofocus @onclick="CloseExpandedStats">
                            <i class="bi bi-x-lg" aria-hidden="true"></i>
                        </button>
                    </header>

                    <div class="home-stats-modal-body">
                        @switch (_expandedSection.Value)
                        {
                            case StatsSection.Activity:
