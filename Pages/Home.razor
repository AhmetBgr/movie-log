@page "/"
@inject WatchlistService Watchlist
@inject NavigationManager NavManager
@implements IDisposable

<PageTitle>Library Statistics</PageTitle>

<div class="container py-4 home-stats" style="padding-left: 4.5px; padding-right: 4.5px;">
    <style>
        @@media (max-width: 768px) {
            .home-stats.container {
                padding-left: 8px !important;
                padding-right: 8px !important;
            }

            .home-stat-card { padding: 16px !important; }
            .home-kpi-value { font-size: 1.55rem !important; }
            .home-activity-chart { height: 210px !important; }
            .home-chart-label { font-size: 0.62rem !important; }
        }

        .stat-card {
            background: transparent;
            border-radius: 12px;
            border: none;
            padding: 20px;
            height: 100%;
        }

        .stat-card-title {
            font-size: 1.1rem;
            font-weight: 700;
            color: #333;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
        }

        .stat-card-title i {
            margin-right: 8px;
            color: #6366f1;
        }

        .director-link { transition: all 0.2s; }
        .director-link:hover {
            color: #6366f1 !important;
            text-decoration: underline !important;
        }

        .bg-alternate { background: rgba(99, 102, 241, 0.05); }
        .rating-row { transition: background 0.2s; }
        .rating-row:hover { background: rgba(99, 102, 241, 0.08); }
        .cursor-pointer { cursor: pointer; }

        .rating-movie-title {
            cursor: pointer;
            transition: color 0.1s ease;
        }

        .rating-movie-title:hover { color: #f97316 !important; }
        .home-like-icon { font-size: 0.72rem; vertical-align: middle; flex-shrink: 0; line-height: 0; }
        .home-like-icon.liked { color: #22c55e; }
        .home-like-icon.disliked { color: #ef4444; }
        .extra-small { font-size: 0.75rem; }

        .home-section-heading {
            color: #0f172a;
            font-size: 0.78rem;
            font-weight: 800;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            margin-bottom: 12px;
        }

        .home-stat-card {
            background: #fff;
            border: 1px solid #e9edf3;
            border-radius: 16px;
            box-shadow: 0 8px 24px rgba(15, 23, 42, 0.035);
            height: 100%;
            padding: 20px;
        }

        .home-card-title {
            color: #0f172a;
            font-size: 1rem;
            font-weight: 750;
            margin: 0;
        }

        .home-card-subtitle {
            color: #64748b;
            font-size: 0.78rem;
            margin-top: 3px;
        }

        .home-kpi {
            background: #fff;
            border: 1px solid #e9edf3;
            border-radius: 14px;
            color: inherit;
            display: block;
            height: 100%;
            padding: 14px 15px;
            text-decoration: none;
            transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
        }

        .home-kpi:hover {
            border-color: #c7d2fe;
            box-shadow: 0 8px 20px rgba(99, 102, 241, 0.08);
            color: inherit;
            transform: translateY(-1px);
        }

        .home-kpi-icon {
            align-items: center;
            border-radius: 9px;
            display: inline-flex;
            height: 30px;
            justify-content: center;
            margin-bottom: 10px;
            width: 30px;
        }

        .home-kpi-value {
            color: #0f172a;
            font-size: 1.75rem;
            font-weight: 800;
            letter-spacing: -0.04em;
            line-height: 1;
        }

        .home-kpi-label {
            color: #64748b;
            font-size: 0.7rem;
            font-weight: 750;
            letter-spacing: 0.04em;
            margin-top: 6px;
            text-transform: uppercase;
        }

        .home-micro-stat {
            background: #f8fafc;
            border-radius: 10px;
            min-width: 92px;
            padding: 8px 11px;
        }

        .home-micro-value {
            color: #0f172a;
            display: block;
            font-size: 0.95rem;
            font-weight: 800;
            line-height: 1.1;
        }

        .home-micro-label {
            color: #64748b;
            display: block;
            font-size: 0.64rem;
            font-weight: 700;
            letter-spacing: 0.03em;
            margin-top: 3px;
            text-transform: uppercase;
        }

        .home-chart-scroll {
            overflow-x: auto;
            overflow-y: hidden;
            padding-bottom: 4px;
        }

        .home-chart-scroll::-webkit-scrollbar { height: 4px; }
        .home-chart-scroll::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }

        .home-activity-chart {
            align-items: stretch;
            display: flex;
            gap: 8px;
            height: 230px;
            min-width: 600px;
            padding-top: 18px;
        }

        .home-activity-column {
            align-items: center;
            display: flex;
            flex: 1;
            flex-direction: column;
            min-width: 34px;
        }

        .home-activity-count {
            color: #475569;
            font-size: 0.72rem;
            font-weight: 800;
            height: 20px;
        }

        .home-activity-track {
            align-items: flex-end;
            border-bottom: 1px solid #e2e8f0;
            display: flex;
            flex: 1;
            justify-content: center;
            width: 100%;
        }

        .home-activity-bar {
            background: linear-gradient(180deg, #34d399 0%, #10b981 100%);
            border-radius: 7px 7px 2px 2px;
            min-height: 3px;
            transition: height 0.35s ease, opacity 0.15s ease;
            width: min(58%, 34px);
        }

        .home-activity-bar.empty { min-height: 0; opacity: 0.16; }
        .home-activity-column:hover .home-activity-bar { opacity: 0.75; }

        .home-chart-label {
            color: #64748b;
            font-size: 0.7rem;
            font-weight: 700;
            margin-top: 8px;
        }

        .home-rating-summary {
            display: grid;
            gap: 8px;
            grid-template-columns: repeat(3, 1fr);
            margin: 18px 0 22px;
        }

        .home-rating-summary > div {
            background: #f8fafc;
            border-radius: 10px;
            padding: 10px 6px;
            text-align: center;
        }

        .home-rating-summary strong {
            display: block;
            font-size: 1.25rem;
            line-height: 1.1;
        }

        .home-rating-summary span {
            color: #64748b;
            display: block;
            font-size: 0.62rem;
            font-weight: 750;
            letter-spacing: 0.04em;
            margin-top: 5px;
            text-transform: uppercase;
        }

        .home-histogram {
            align-items: stretch;
            display: flex;
            gap: 4px;
            height: 170px;
        }

        .home-histogram-column {
            align-items: center;
            background: transparent;
            border: 0;
            color: inherit;
            display: flex;
            flex: 1;
            flex-direction: column;
            min-width: 0;
            padding: 0;
        }

        .home-histogram-count {
            color: #64748b;
            font-size: 0.65rem;
            font-weight: 800;
            height: 18px;
        }

        .home-histogram-track {
            align-items: flex-end;
            border-bottom: 1px solid #dbe3ec;
            display: flex;
            flex: 1;
            justify-content: center;
            width: 100%;
        }

        .home-histogram-fill {
            border-radius: 5px 5px 0 0;
            min-height: 2px;
            opacity: 0.9;
            transition: height 0.3s ease, opacity 0.15s ease;
            width: 70%;
        }

        .home-histogram-column:hover .home-histogram-fill,
        .home-histogram-column:focus .home-histogram-fill { opacity: 0.65; }
        .home-histogram-column:disabled { cursor: default; }
        .home-histogram-column:disabled:hover .home-histogram-fill { opacity: 0.9; }

        .home-histogram-label {
            color: #64748b;
            font-size: 0.58rem;
            font-weight: 700;
            margin-top: 7px;
            white-space: nowrap;
        }

        .home-reaction-bar {
            background: #e2e8f0;
            border-radius: 999px;
            display: flex;
            height: 24px;
            margin: 24px 0 12px;
            overflow: hidden;
        }

        .home-reaction-liked { background: #22c55e; }
        .home-reaction-disliked { background: #ef4444; }
        .home-reaction-unmarked { background: #cbd5e1; }

        .home-reaction-list {
            display: grid;
            gap: 10px;
            margin-top: 20px;
        }

        .home-reaction-row {
            align-items: center;
            display: grid;
            gap: 10px;
            grid-template-columns: 12px 1fr auto;
        }

        .home-reaction-dot { border-radius: 4px; height: 10px; width: 10px; }
        .home-reaction-name { color: #334155; font-size: 0.86rem; font-weight: 650; }
        .home-reaction-number { color: #0f172a; font-size: 0.86rem; font-weight: 800; }
        .home-reaction-number small { color: #94a3b8; font-size: 0.72rem; font-weight: 650; margin-left: 4px; }

        .home-insight-list { display: grid; gap: 17px; margin-top: 20px; }
        .home-insight-row { min-width: 0; }

        .home-insight-heading {
            align-items: baseline;
            display: flex;
            gap: 10px;
            justify-content: space-between;
            margin-bottom: 6px;
        }

        .home-insight-name {
            background: none;
            border: 0;
            color: #1e293b;
            font-size: 0.88rem;
            font-weight: 750;
            max-width: 58%;
            overflow: hidden;
            padding: 0;
            text-decoration: none;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        button.home-insight-name:hover,
        a.home-insight-name:hover { color: #6366f1; text-decoration: underline; }

        .home-insight-values {
            color: #64748b;
            font-size: 0.72rem;
            font-weight: 650;
            text-align: right;
            white-space: nowrap;
        }

        .home-insight-values strong { color: #334155; }

        .home-progress-track {
            background: #eef2f7;
            border-radius: 999px;
            height: 7px;
            overflow: hidden;
        }

        .home-progress-fill {
            background: linear-gradient(90deg, #818cf8, #6366f1);
            border-radius: inherit;
            height: 100%;
        }

        .home-profile-tabs {
            background: #f1f5f9;
            border-radius: 10px;
            display: inline-flex;
            gap: 3px;
            padding: 3px;
        }

        .home-profile-tab {
            background: transparent;
            border: 0;
            border-radius: 8px;
            color: #64748b;
            font-size: 0.75rem;
            font-weight: 750;
            padding: 7px 11px;
        }

        .home-profile-tab.active {
            background: #fff;
            box-shadow: 0 1px 3px rgba(15, 23, 42, 0.12);
            color: #4338ca;
        }

        .home-profile-grid {
            display: grid;
            gap: 14px 28px;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            margin-top: 22px;
        }

        @@media (max-width: 768px) {
            .home-profile-grid { grid-template-columns: 1fr; }
            .home-profile-tabs { display: flex; width: 100%; }
            .home-profile-tab { flex: 1; padding-left: 6px; padding-right: 6px; }
            .home-insight-heading { align-items: stretch; flex-direction: column; gap: 3px; }
            .home-insight-name { max-width: 100%; }
            .home-insight-values { text-align: left; white-space: normal; }
        }

        .home-profile-row {
            align-items: center;
            display: grid;
            gap: 10px;
            grid-template-columns: minmax(72px, 120px) 1fr 34px;
        }

        .home-profile-label {
            color: #334155;
            font-size: 0.78rem;
            font-weight: 700;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .home-profile-count { color: #475569; font-size: 0.75rem; font-weight: 800; text-align: right; }
        .home-empty { color: #94a3b8; font-size: 0.85rem; padding: 28px 0; text-align: center; }

        .home-see-more {
            align-items: center;
            background: transparent;
            border: 0;
            color: #4f46e5;
            display: inline-flex;
            flex-shrink: 0;
            font-size: 0.78rem;
            font-weight: 750;
            gap: 5px;
            padding: 3px 0;
        }

        .home-see-more:hover,
        .home-see-more:focus-visible { color: #312e81; text-decoration: underline; }

        .home-stats-modal-backdrop {
            align-items: center;
            background: rgba(15, 23, 42, 0.68);
            display: flex;
            inset: 0;
            justify-content: center;
            padding: 24px;
            position: fixed;
            z-index: 1100;
        }

        .home-stats-modal {
            background: #fff;
            border-radius: 18px;
            box-shadow: 0 28px 80px rgba(15, 23, 42, 0.3);
            display: flex;
            flex-direction: column;
            max-height: min(88vh, 860px);
            max-width: 980px;
            overflow: hidden;
            width: 100%;
        }

        .home-stats-modal-header {
            align-items: flex-start;
            border-bottom: 1px solid #e9edf3;
            display: flex;
            gap: 18px;
            justify-content: space-between;
            padding: 20px 24px;
        }

        .home-stats-modal-body {
            overflow-x: hidden;
            overflow-y: auto;
            overscroll-behavior: contain;
            padding: 22px 24px 26px;
        }

        .home-modal-close {
            align-items: center;
            background: #f1f5f9;
            border: 0;
            border-radius: 50%;
            color: #475569;
            display: inline-flex;
            flex: 0 0 auto;
            height: 34px;
            justify-content: center;
            width: 34px;
        }

        .home-modal-kpis {
            display: grid;
            gap: 10px;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            margin-bottom: 22px;
        }

        .home-modal-kpi {
            background: #f8fafc;
            border: 1px solid #eef2f7;
            border-radius: 12px;
            padding: 13px;
        }

        .home-modal-kpi strong { color: #0f172a; display: block; font-size: 1.3rem; line-height: 1.1; }
        .home-modal-kpi span { color: #64748b; display: block; font-size: 0.67rem; font-weight: 750; margin-top: 5px; text-transform: uppercase; }
        .home-modal-section-title { color: #334155; font-size: 0.78rem; font-weight: 800; letter-spacing: 0.05em; margin: 22px 0 10px; text-transform: uppercase; }

        .home-modal-table {
            border: 1px solid #e9edf3;
            border-radius: 12px;
            overflow: hidden;
        }

        .home-modal-table-row {
            align-items: center;
            border-bottom: 1px solid #eef2f7;
            display: grid;
            gap: 12px;
            grid-template-columns: minmax(120px, 1.5fr) repeat(3, minmax(70px, 0.7fr));
            padding: 10px 13px;
        }

        .home-modal-table-row:last-child { border-bottom: 0; }
        .home-modal-table-row.header { background: #f8fafc; color: #64748b; font-size: 0.66rem; font-weight: 800; text-transform: uppercase; }
        .home-modal-table-row > :not(:first-child) { text-align: right; }
        .home-modal-table-name { color: #1e293b; font-size: 0.84rem; font-weight: 750; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        button.home-modal-table-name, a.home-modal-table-name { background: none; border: 0; padding: 0; text-align: left; text-decoration: none; }
        button.home-modal-table-name:hover, a.home-modal-table-name:hover { color: #4f46e5; text-decoration: underline; }
        .home-modal-table-value { color: #475569; font-size: 0.8rem; font-weight: 700; }

        @@media (max-width: 575px) {
            .home-stats-modal-backdrop { align-items: stretch; padding: 8px; }
            .home-stats-modal { border-radius: 14px; max-height: none; }
            .home-stats-modal-header { padding: 16px; }
            .home-stats-modal-body { padding: 16px; }
            .home-modal-kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); }
            .home-modal-table { overflow-x: auto; }
            .home-modal-table-row { min-width: 580px; }
        }
    </style>

    <div class="mb-4 pb-3 border-bottom">
        <h1 class="mb-1 fw-bolder text-dark">Statistics</h1>
        <p class="text-muted mb-0">Useful patterns from your library and viewing activity.</p>
    </div>

    @if (RecentRatings.Any() || RecentWatchlist.Any())
    {
        <div class="row g-4 mb-4">
            @if (RecentRatings.Any())
            {
                <div class="col-12 col-lg-6">
                    <div class="stat-card h-100">
                        <div class="stat-card-title justify-content-between">
                            <div><i class="bi bi-clock-history"></i> Recent Ratings</div>
                            <button class="btn btn-link text-decoration-none text-muted fw-bold p-0"
                                    @onclick='() => NavManager.NavigateTo("library/watched")'
                                    style="font-size: 0.85rem;">
                                Show All <i class="bi bi-chevron-right small"></i>
                            </button>
                        </div>
                        <div class="recent-ratings-list mt-1">
                            @foreach (var (item, index) in RecentRatings.Select((v, i) => (v, i)))
                            {
                                var rating = item.Rating20 ?? 0;
                                var color = Visuals.GetRatingColor(rating);

                                <div class="rating-row d-flex align-items-center py-1 px-2 mb-1 @(index % 2 != 0 ? "bg-alternate" : "")" style="border-radius: 6px;">
                                    <div class="d-flex align-items-baseline me-1" style="min-width: 26px;">
                                        <span class="fw-bold" style="color: @color; font-size: 1.15rem; min-width: 28px; display: inline-block;">@rating</span>
                                    </div>
                                    <div class="text-dark d-flex flex-wrap align-items-baseline overflow-hidden" style="font-size: 1.1rem;">
                                        <OpenOnMenu Item="item" ButtonClass="me-1" />
                                        <span class="fw-bold rating-movie-title text-truncate" @onclick="() => Watchlist.ShowDetailsAsync(item)">@item.Title</span>
                                        @if (item.IsLiked == true)
                                        {
                                            <i class="bi bi-hand-thumbs-up-fill home-like-icon liked ms-1" title="Liked"></i>
                                        }
                                        else if (item.IsLiked == false)
                                        {
                                            <i class="bi bi-hand-thumbs-down-fill home-like-icon disliked ms-1" title="Disliked"></i>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(GetYearOnly(item.Year)))
                                        {
                                            <span class="text-muted opacity-50 mx-1">•</span>
                                            <span class="text-muted small opacity-75">(@GetYearOnly(item.Year))</span>
                                        }
                                        <span class="text-muted opacity-50 mx-1 d-none d-sm-inline">•</span>
                                        <span class="text-muted extra-small opacity-75 d-none d-sm-inline">@item.DateAdded.ToString("dd MMM yyyy")</span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

            @if (RecentWatchlist.Any())
            {
                <div class="col-12 col-lg-6">
                    <div class="stat-card h-100">
                        <div class="stat-card-title justify-content-between">
                            <div><i class="bi bi-bookmark-plus"></i> Recent Watchlist</div>
                            <button class="btn btn-link text-decoration-none text-muted fw-bold p-0"
                                    @onclick='() => NavManager.NavigateTo("library/watchlist")'
                                    style="font-size: 0.85rem;">
                                Show All <i class="bi bi-chevron-right small"></i>
                            </button>
                        </div>
                        <div class="recent-watchlist-list mt-1">
                            @foreach (var (item, index) in RecentWatchlist.Select((v, i) => (v, i)))
                            {
                                <div class="rating-row d-flex align-items-center py-1 px-2 mb-1 @(index % 2 != 0 ? "bg-alternate" : "")" style="border-radius: 6px;">
                                    <div class="d-flex align-items-baseline me-1" style="min-width: 26px;">
                                        <i class="bi bi-bookmark-fill" style="color: #64748b; font-size: 1rem;"></i>
                                    </div>
                                    <div class="text-dark d-flex flex-wrap align-items-baseline overflow-hidden" style="font-size: 1.1rem;">
                                        <OpenOnMenu Item="item" ButtonClass="me-1" />
                                        <span class="fw-bold rating-movie-title text-truncate" @onclick="() => Watchlist.ShowDetailsAsync(item)">@item.Title</span>
                                        @if (item.IsLiked == true)
                                        {
                                            <i class="bi bi-hand-thumbs-up-fill home-like-icon liked ms-1" title="Liked"></i>
                                        }
                                        else if (item.IsLiked == false)
                                        {
                                            <i class="bi bi-hand-thumbs-down-fill home-like-icon disliked ms-1" title="Disliked"></i>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(GetYearOnly(item.Year)))
                                        {
                                            <span class="text-muted opacity-50 mx-1">•</span>
                                            <span class="text-muted small opacity-75">(@GetYearOnly(item.Year))</span>
                                        }
                                        <span class="text-muted opacity-50 mx-1 d-none d-sm-inline">•</span>
                                        <span class="text-muted extra-small opacity-75 d-none d-sm-inline">@item.DateAdded.ToString("dd MMM yyyy")</span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @if (TotalCount == 0)
    {
        <div class="home-stat-card home-empty">
            Add titles to your library to see statistics and viewing patterns here.
        </div>
    }
    else
    {
        <div class="row g-4 align-items-stretch mb-4">
        <section class="col-12 col-lg-4">
        <div class="home-section-heading">At a glance</div>
        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-2 g-3">
            <div class="col">
                <a class="home-kpi" href="library">
                    <span class="home-kpi-icon" style="background:#eef2ff;color:#4f46e5;"><i class="bi bi-collection-play"></i></span>
                    <div class="home-kpi-value">@TotalCount</div>
                    <div class="home-kpi-label">Total titles</div>
                </a>
            </div>
            <div class="col">
                <a class="home-kpi" href="library/watched">
                    <span class="home-kpi-icon" style="background:#ecfdf5;color:#059669;"><i class="bi bi-check2-circle"></i></span>
                    <div class="home-kpi-value">@WatchedCount</div>
                    <div class="home-kpi-label">Watched</div>
                </a>
            </div>
            <div class="col">
                <a class="home-kpi" href="library/watching">
                    <span class="home-kpi-icon" style="background:#eff6ff;color:#2563eb;"><i class="bi bi-play-circle"></i></span>
                    <div class="home-kpi-value">@WatchingCount</div>
                    <div class="home-kpi-label">Watching</div>
                </a>
            </div>
            <div class="col">
                <a class="home-kpi" href="library/watchlist">
                    <span class="home-kpi-icon" style="background:#f8fafc;color:#64748b;"><i class="bi bi-bookmark"></i></span>
                    <div class="home-kpi-value">@WatchlistCount</div>
                    <div class="home-kpi-label">Watchlist</div>
                </a>
            </div>
            <div class="col">
                <a class="home-kpi" href="library/watched">
