                                    <div class="home-modal-kpi"><strong>@MonthlyAverage.ToString("0.0")</strong><span>Monthly average</span></div>
                                    <div class="home-modal-kpi"><strong>@BusiestMonth</strong><span>Busiest month</span></div>
                                    <div class="home-modal-kpi"><strong>@ActiveMonthCount</strong><span>Active months</span></div>
                                </div>

                                <div class="home-chart-scroll">
                                    @{ var modalMaxMonth = MoviesPerMonth.Any() ? MoviesPerMonth.Max(x => x.Value) : 0; }
                                    <div class="home-activity-chart" role="img" aria-label="Expanded monthly watched activity for @SelectedYear">
                                        @foreach (var month in MoviesPerMonth)
                                        {
                                            var height = modalMaxMonth > 0 ? month.Value * 100d / modalMaxMonth : 0;
                                            <div class="home-activity-column" title="@month.Key @SelectedYear: @month.Value marked watched">
                                                <div class="home-activity-count">@(month.Value > 0 ? month.Value.ToString() : "")</div>
                                                <div class="home-activity-track"><div class="home-activity-bar @(month.Value == 0 ? "empty" : "")" style="height:@CssPercent(height);"></div></div>
                                                <div class="home-chart-label">@month.Key</div>
                                            </div>
                                        }
                                    </div>
                                </div>

                                <h3 class="home-modal-section-title">Year comparison</h3>
                                <div class="home-modal-table">
                                    <div class="home-modal-table-row header"><span>Year</span><span>Watched</span><span>Avg / month</span><span>Busiest</span></div>
                                    @foreach (var year in ActivityByYear)
                                    {
                                        <div class="home-modal-table-row">
                                            <span class="home-modal-table-name">@year.Year · @year.ActiveMonths active months</span>
                                            <span class="home-modal-table-value">@year.Count</span>
                                            <span class="home-modal-table-value">@year.MonthlyAverage.ToString("0.0")</span>
                                            <span class="home-modal-table-value">@year.BusiestMonth</span>
                                        </div>
                                    }
                                </div>
                                break;

                            case StatsSection.Ratings:
                                <div class="home-modal-kpis">
                                    <div class="home-modal-kpi"><strong style="color:@Visuals.GetRatingColor(AvgRating);">@(RatedCount > 0 ? AvgRating.ToString("0.0") : "—")</strong><span>Average</span></div>
                                    <div class="home-modal-kpi"><strong style="color:@Visuals.GetRatingColor(MedianRating);">@(RatedCount > 0 ? MedianRating.ToString("0.0") : "—")</strong><span>Median</span></div>
                                    <div class="home-modal-kpi"><strong>@(RatedCount > 0 ? HighestRating : "—")</strong><span>Highest</span></div>
                                    <div class="home-modal-kpi"><strong>@(RatedCount > 0 ? LowestRating : "—")</strong><span>Lowest</span></div>
