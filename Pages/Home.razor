                                    <div class="home-modal-kpi"><strong>@DislikedCount</strong><span>Disliked · @FormatPercent(DislikePercentage)</span></div>
                                    <div class="home-modal-kpi"><strong>@ReactionCoveragePercent%</strong><span>Reaction coverage</span></div>
                                    <div class="home-modal-kpi"><strong>@UnmarkedCount</strong><span>No reaction</span></div>
                                </div>

                                <div class="home-reaction-bar" role="img" aria-label="Expanded reaction distribution">
