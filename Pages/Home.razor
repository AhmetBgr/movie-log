                <div>
                    <h2 class="home-card-title"><i class="bi bi-bar-chart-fill me-2" style="color:#10b981;"></i>Marked watched in @SelectedYear</h2>
                    <div class="home-card-subtitle">Activity is based on the date a title was moved to Watched.</div>
                </div>
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <div class="home-micro-stat">
                        <span class="home-micro-value">@YearlyTotal</span>
                        <span class="home-micro-label">Year total</span>
                    </div>
                    <div class="home-micro-stat">
                        <span class="home-micro-value">@MonthlyAverage.ToString("0.0")</span>
                        <span class="home-micro-label">Per month</span>
                    </div>
                    <div class="home-micro-stat">
                        <span class="home-micro-value">@BusiestMonth</span>
                        <span class="home-micro-label">Busiest month</span>
                    </div>
