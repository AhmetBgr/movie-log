                                            <span class="home-modal-table-value">@status.Liked</span>
                                            <span class="home-modal-table-value">@status.Disliked</span>
                                            <span class="home-modal-table-value">@status.Unmarked</span>
                                        </div>
                                    }
                                </div>
                                break;

                            case StatsSection.Genres:
                                <div class="home-modal-kpis">
                                    <div class="home-modal-kpi"><strong>@AllGenreInsights.Count</strong><span>Genres</span></div>
                                    <div class="home-modal-kpi"><strong>@(AllGenreInsights.FirstOrDefault()?.Name ?? "—")</strong><span>Most watched</span></div>
                                    <div class="home-modal-kpi"><strong>@(AllGenreInsights.FirstOrDefault()?.Count ?? 0)</strong><span>Top genre titles</span></div>
                                    <div class="home-modal-kpi"><strong>@WatchedCount</strong><span>Watched titles</span></div>
                                </div>
