                                            <span class="home-modal-table-value">@(genre.ReactionCount > 0 ? $"{genre.LikePercent:0}%" : "—")</span>
                                        </div>
                                    }
                                </div>
                                break;

                            case StatsSection.Directors:
                                <div class="home-modal-kpis">
                                    <div class="home-modal-kpi"><strong>@AllDirectorInsights.Count</strong><span>Directors</span></div>
                                    <div class="home-modal-kpi"><strong>@(AllDirectorInsights.FirstOrDefault()?.Name ?? "—")</strong><span>Most watched</span></div>
                                    <div class="home-modal-kpi"><strong>@(AllDirectorInsights.FirstOrDefault()?.Count ?? 0)</strong><span>Top director titles</span></div>
                                    <div class="home-modal-kpi"><strong>@WatchedCount</strong><span>Watched titles</span></div>
                                </div>
                                <div class="home-modal-table">
                                    <div class="home-modal-table-row header"><span>Director</span><span>Watched</span><span>Average</span><span>Liked</span></div>
                                    @foreach (var director in AllDirectorInsights)
                                    {
                                        <div class="home-modal-table-row">
                                            <a class="home-modal-table-name" href="@GetPersonNameUrl(director.Name)">@director.Name</a>
                                            <span class="home-modal-table-value">@director.Count</span>
                                            <span class="home-modal-table-value">@(director.AverageRating?.ToString("0.0") ?? "—") <small>(@director.RatedCount)</small></span>
                                            <span class="home-modal-table-value">@(director.ReactionCount > 0 ? $"{director.LikePercent:0}%" : "—")</span>
                                        </div>
                                    }
                                </div>
                                break;

                            case StatsSection.Profile:
                                <div class="home-modal-kpis">
                                    <div class="home-modal-kpi"><strong>@DecadeDistribution.Count</strong><span>Release decades</span></div>
                                    <div class="home-modal-kpi"><strong>@RuntimeDistribution.Count</strong><span>Runtime groups</span></div>
                                    <div class="home-modal-kpi"><strong>@TitleTypeDistribution.Count</strong><span>Title types</span></div>
                                    <div class="home-modal-kpi"><strong>@WatchedCount</strong><span>Watched titles</span></div>
                                </div>

                                <h3 class="home-modal-section-title">Release decades</h3>
                                <div class="home-profile-grid">
                                    @{ var maxDecade = DecadeDistribution.Any() ? DecadeDistribution.Max(x => x.Value) : 0; }
                                    @foreach (var entry in DecadeDistribution)
                                    {
                                        <div class="home-profile-row"><span class="home-profile-label">@entry.Key</span><div class="home-progress-track"><div class="home-progress-fill" style="width:@CssPercent(maxDecade > 0 ? entry.Value * 100d / maxDecade : 0);"></div></div><span class="home-profile-count">@entry.Value</span></div>
                                    }
                                </div>

                                <h3 class="home-modal-section-title">Runtime</h3>
                                <div class="home-profile-grid">
                                    @{ var maxRuntime = RuntimeDistribution.Any() ? RuntimeDistribution.Max(x => x.Value) : 0; }
                                    @foreach (var entry in RuntimeDistribution)
                                    {
                                        <div class="home-profile-row"><span class="home-profile-label">@entry.Key</span><div class="home-progress-track"><div class="home-progress-fill" style="width:@CssPercent(maxRuntime > 0 ? entry.Value * 100d / maxRuntime : 0);background:linear-gradient(90deg,#38bdf8,#0ea5e9);"></div></div><span class="home-profile-count">@entry.Value</span></div>
                                    }
                                </div>

                                <h3 class="home-modal-section-title">Title types</h3>
                                <div class="home-profile-grid">
                                    @{ var maxType = TitleTypeDistribution.Any() ? TitleTypeDistribution.Max(x => x.Value) : 0; }
                                    @foreach (var entry in TitleTypeDistribution)
                                    {
                                        <div class="home-profile-row"><span class="home-profile-label">@entry.Key</span><div class="home-progress-track"><div class="home-progress-fill" style="width:@CssPercent(maxType > 0 ? entry.Value * 100d / maxType : 0);background:linear-gradient(90deg,#a78bfa,#7c3aed);"></div></div><span class="home-profile-count">@entry.Value</span></div>
                                    }
                                </div>
                                break;
                        }
                    </div>
                </section>
            </div>
        }
    }
</div>

@code {
    private int TotalCount => Watchlist.Items.Count;
    private int WatchlistCount => Watchlist.Items.Count(i => i.Status == WatchlistStatus.Pending);
    private int WatchingCount => Watchlist.Items.Count(i => i.Status == WatchlistStatus.Watching);
    private int WatchedCount => Watchlist.Items.Count(i => i.Status == WatchlistStatus.Watched);
    private int RatedCount { get; set; }
    private int LikedCount => Watchlist.Items.Count(i => i.IsLiked == true);
    private int DislikedCount => Watchlist.Items.Count(i => i.IsLiked == false);
    private int UnmarkedCount => Math.Max(0, TotalCount - LikedCount - DislikedCount);
    private int RatingCoveragePercent => WatchedCount > 0 ? (int)Math.Round(RatedCount * 100d / WatchedCount) : 0;
    private double LikePercentage => Percentage(LikedCount, TotalCount);
    private double DislikePercentage => Percentage(DislikedCount, TotalCount);
    private double UnmarkedPercentage => Percentage(UnmarkedCount, TotalCount);
    private int ReactionCoveragePercent => TotalCount > 0 ? (int)Math.Round((LikedCount + DislikedCount) * 100d / TotalCount) : 0;
    private int ActiveMonthCount => MoviesPerMonth.Count(month => month.Value > 0);

    private int SelectedYear = DateTime.Now.Year;
    private int YearlyTotal;
    private List<int> AvailableYears = new();
    private List<KeyValuePair<string, int>> MoviesPerMonth = new();
    private double MonthlyAverage => YearlyTotal / (double)Math.Max(1, SelectedYear == DateTime.Now.Year ? DateTime.Now.Month : 12);
    private string BusiestMonth
    {
        get
        {
            var busiest = MoviesPerMonth.OrderByDescending(x => x.Value).FirstOrDefault();
            return busiest.Value > 0 ? busiest.Key : "—";
        }
    }

    private double AvgRating;
    private double MedianRating;
    private int HighestRating;
    private int LowestRating;
    private List<RatingBucket> RatingDistribution = new();
    private List<RatingBand> RatingBands = new();
    private List<TasteInsight> GenreInsights = new();
    private List<TasteInsight> DirectorInsights = new();
    private List<TasteInsight> AllGenreInsights = new();
    private List<TasteInsight> AllDirectorInsights = new();
    private List<YearActivityInsight> ActivityByYear = new();
    private List<KeyValuePair<string, int>> DecadeDistribution = new();
    private List<KeyValuePair<string, int>> RuntimeDistribution = new();
    private List<KeyValuePair<string, int>> TitleTypeDistribution = new();
    private string _profileView = "decades";
    private StatsSection? _expandedSection;
    private IReadOnlyList<KeyValuePair<string, int>> CurrentProfileDistribution => _profileView switch
    {
        "runtime" => RuntimeDistribution,
        "types" => TitleTypeDistribution,
        _ => DecadeDistribution
    };

    private List<WatchlistItem> RecentRatings = new();
    private List<WatchlistItem> RecentWatchlist = new();
    private const int RecentRatingsCount = 10;
    private const int RecentWatchlistCount = 10;

    protected override void OnInitialized()
    {
        Watchlist.OnStateChanged += HandleStateChanged;
        CalculateStats();
    }

    private void HandleStateChanged()
    {
        CalculateStats();
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnYearChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var year))
        {
            SelectedYear = year;
            CalculateActivity(Watchlist.Items.Where(i => i.Status == WatchlistStatus.Watched).ToList());
        }
    }

    private void OpenExpandedStats(StatsSection section) => _expandedSection = section;
    private void CloseExpandedStats() => _expandedSection = null;

    private void HandleModalKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") CloseExpandedStats();
    }

    private static string GetExpandedTitle(StatsSection section) => section switch
    {
        StatsSection.Activity => "Viewing activity",
        StatsSection.Ratings => "Rating statistics",
        StatsSection.Reactions => "Reaction statistics",
        StatsSection.Genres => "Genre statistics",
        StatsSection.Directors => "Director statistics",
        StatsSection.Profile => "Full library profile",
        _ => "Statistics"
    };

    private static string GetExpandedSubtitle(StatsSection section) => section switch
    {
        StatsSection.Activity => "Monthly activity and year-by-year comparison.",
        StatsSection.Ratings => "Your full score distribution, range, and rating coverage.",
        StatsSection.Reactions => "Likes and dislikes across each part of your library.",
        StatsSection.Genres => "Every watched genre with volume, rating sample, and like rate.",
        StatsSection.Directors => "Every watched director with volume, rating sample, and like rate.",
        StatsSection.Profile => "Release decades, runtime groups, and title types together.",
        _ => "Expanded library statistics."
    };

    private void CalculateStats()
    {
        var watched = Watchlist.Items.Where(i => i.Status == WatchlistStatus.Watched).ToList();

        AvailableYears = watched
            .Where(item => item.DateAdded != default)
            .Select(item => item.DateAdded.Year)
            .Append(DateTime.Now.Year)
            .Distinct()
            .OrderByDescending(year => year)
            .ToList();

        if (!AvailableYears.Contains(SelectedYear))
            SelectedYear = AvailableYears.FirstOrDefault(DateTime.Now.Year);

        CalculateActivity(watched);

        ActivityByYear = AvailableYears
            .Select(year =>
            {
                var yearItems = watched.Where(item => item.DateAdded.Year == year).ToList();
                var monthlyCounts = Enumerable.Range(1, 12)
                    .Select(month => yearItems.Count(item => item.DateAdded.Month == month))
                    .ToList();
                var busiestIndex = monthlyCounts.Count > 0 ? monthlyCounts.IndexOf(monthlyCounts.Max()) : -1;
                var busiest = busiestIndex >= 0 && monthlyCounts[busiestIndex] > 0
                    ? new DateTime(year, busiestIndex + 1, 1).ToString("MMM")
                    : "—";
                var elapsedMonths = year == DateTime.Now.Year ? DateTime.Now.Month : 12;
                return new YearActivityInsight(year, yearItems.Count, monthlyCounts.Count(count => count > 0),
                    yearItems.Count / (double)Math.Max(1, elapsedMonths), busiest);
            })
            .ToList();

        var ratedMovies = watched.Where(item => item.Rating20.HasValue).ToList();
        RatedCount = ratedMovies.Count;
        AvgRating = ratedMovies.Count > 0 ? ratedMovies.Average(item => item.Rating20!.Value) : 0;
        HighestRating = ratedMovies.Count > 0 ? ratedMovies.Max(item => item.Rating20!.Value) : 0;
        LowestRating = ratedMovies.Count > 0 ? ratedMovies.Min(item => item.Rating20!.Value) : 0;

        var sortedRatings = ratedMovies.Select(item => item.Rating20!.Value).OrderBy(rating => rating).ToList();
        MedianRating = sortedRatings.Count switch
        {
            0 => 0,
            var count when count % 2 == 1 => sortedRatings[count / 2],
            var count => (sortedRatings[count / 2 - 1] + sortedRatings[count / 2]) / 2d
        };

        RatingDistribution = Enumerable.Range(1, 10)
            .Select(index =>
            {
                var lower = (index - 1) * 10 + 1;
                var upper = index * 10;
                return new RatingBucket($"{lower}–{upper}", index.ToString(), lower, upper,
                    ratedMovies.Count(item => item.Rating20 >= lower && item.Rating20 <= upper));
            })
            .ToList();

        RatingBands = new List<RatingBand>
        {
            new("Excellent", "80–100", ratedMovies.Count(item => item.Rating20 is >= 80 and <= 100)),
            new("Good", "60–79", ratedMovies.Count(item => item.Rating20 is >= 60 and < 80)),
            new("Mixed", "40–59", ratedMovies.Count(item => item.Rating20 is >= 40 and < 60)),
            new("Low", "1–39", ratedMovies.Count(item => item.Rating20 is >= 1 and < 40))
        };

        AllGenreInsights = watched
            .Where(item => !string.IsNullOrWhiteSpace(item.Genres))
            .SelectMany(item => item.Genres.Split(',', StringSplitOptions.RemoveEmptyEntries)
                .Select(genre => new NamedMovie(genre.Trim(), item)))
            .Where(entry => !string.IsNullOrWhiteSpace(entry.Name))
            .GroupBy(entry => entry.Name, StringComparer.OrdinalIgnoreCase)
            .OrderByDescending(group => group.Count())
            .ThenBy(group => group.Key)
            .Select(group => CreateTasteInsight(group.Key, group.Select(entry => entry.Movie)))
            .ToList();
        GenreInsights = AllGenreInsights.Take(6).ToList();

        AllDirectorInsights = watched
            .Where(item => !string.IsNullOrWhiteSpace(item.Director))
            .SelectMany(item => item.Director!.Split(',', StringSplitOptions.RemoveEmptyEntries)
                .Select(director => new NamedMovie(director.Trim(), item)))
            .Where(entry => !string.IsNullOrWhiteSpace(entry.Name))
            .GroupBy(entry => entry.Name, StringComparer.OrdinalIgnoreCase)
            .OrderByDescending(group => group.Count())
            .ThenBy(group => group.Key)
            .Select(group => CreateTasteInsight(group.Key, group.Select(entry => entry.Movie)))
            .ToList();
        DirectorInsights = AllDirectorInsights.Take(6).ToList();

        DecadeDistribution = watched
            .Where(item => item.ParsedYear > 0)
            .GroupBy(item => item.ParsedYear / 10 * 10)
            .OrderBy(group => group.Key)
            .Select(group => new KeyValuePair<string, int>($"{group.Key}s", group.Count()))
            .ToList();

        var runtimes = watched.Where(item => item.Runtime > 0).ToList();
        RuntimeDistribution = new List<KeyValuePair<string, int>>
        {
            new("Under 90 min", runtimes.Count(item => item.Runtime < 90)),
            new("90–120 min", runtimes.Count(item => item.Runtime is >= 90 and <= 120)),
            new("121–150 min", runtimes.Count(item => item.Runtime is > 120 and <= 150)),
            new("151–180 min", runtimes.Count(item => item.Runtime is > 150 and <= 180)),
            new("Over 180 min", runtimes.Count(item => item.Runtime > 180))
        }.Where(entry => entry.Value > 0).ToList();

        TitleTypeDistribution = watched
            .Where(item => !string.IsNullOrWhiteSpace(item.TitleType))
            .GroupBy(item => item.TitleType.Trim(), StringComparer.OrdinalIgnoreCase)
            .OrderByDescending(group => group.Count())
            .ThenBy(group => group.Key)
            .Select(group => new KeyValuePair<string, int>(group.Key, group.Count()))
            .ToList();

        RecentRatings = ratedMovies
            .OrderByDescending(item => item.DateAdded)
            .Take(RecentRatingsCount)
            .ToList();

        RecentWatchlist = Watchlist.Items
            .Where(item => item.Status == WatchlistStatus.Pending)
            .OrderByDescending(item => item.DateAdded)
            .Take(RecentWatchlistCount)
            .ToList();
    }

    private void CalculateActivity(List<WatchlistItem> watched)
    {
        var yearData = watched.Where(item => item.DateAdded.Year == SelectedYear).ToList();
        YearlyTotal = yearData.Count;
        MoviesPerMonth = Enumerable.Range(1, 12)
            .Select(month => new KeyValuePair<string, int>(
                new DateTime(SelectedYear, month, 1).ToString("MMM"),
                yearData.Count(item => item.DateAdded.Month == month)))
            .ToList();
    }

    private static TasteInsight CreateTasteInsight(string name, IEnumerable<WatchlistItem> source)
    {
        var items = source.DistinctBy(item => item.ImdbId).ToList();
        var ratings = items.Where(item => item.Rating20.HasValue).Select(item => item.Rating20!.Value).ToList();
        var reactions = items.Where(item => item.IsLiked.HasValue).ToList();
        var likePercent = reactions.Count > 0 ? reactions.Count(item => item.IsLiked == true) * 100d / reactions.Count : 0;

        return new TasteInsight(
            name,
            items.Count,
            ratings.Count,
            ratings.Count > 0 ? ratings.Average() : null,
            reactions.Count,
            likePercent);
    }

    private IReadOnlyList<ReactionStatusInsight> ReactionByStatus => new[]
    {
        CreateReactionStatusInsight("Watchlist", Watchlist.Items.Where(item => item.Status == WatchlistStatus.Pending)),
        CreateReactionStatusInsight("Watching", Watchlist.Items.Where(item => item.Status == WatchlistStatus.Watching)),
        CreateReactionStatusInsight("Watched", Watchlist.Items.Where(item => item.Status == WatchlistStatus.Watched))
    };

    private static ReactionStatusInsight CreateReactionStatusInsight(string name, IEnumerable<WatchlistItem> source)
    {
        var items = source.ToList();
        return new ReactionStatusInsight(
            name,
            items.Count,
            items.Count(item => item.IsLiked == true),
            items.Count(item => item.IsLiked == false),
            items.Count(item => !item.IsLiked.HasValue));
    }

    private void OpenGenre(string genre)
    {
        PrepareWatchedDrilldown();
        Watchlist.SelectedGenre = genre;
        NavManager.NavigateTo("library/watched");
    }

    private void OpenRatingRange(int lower, int upper)
    {
        PrepareWatchedDrilldown();
        Watchlist.FilterMinRating20 = lower;
        Watchlist.FilterMaxRating20 = upper;
        NavManager.NavigateTo("library/watched");
    }

    private void PrepareWatchedDrilldown()
    {
        Watchlist.ActiveTab = "watched";
        Watchlist.SearchQuery = "";
        Watchlist.SelectedType = "All";
        Watchlist.SelectedGenre = "All";
        Watchlist.StartYear = "";
        Watchlist.EndYear = "";
        Watchlist.FilterMinRating20 = 0;
        Watchlist.FilterMaxRating20 = 100;
        Watchlist.FilterMinVote = 0;
        Watchlist.FilterMaxVote = 10;
        Watchlist.AdvancedFilter = new AdvancedFilterState { IsActive = true };
    }

    private static string GetPersonNameUrl(string name)
        => $"person/name/{Uri.EscapeDataString(name)}";

    private static double Percentage(int value, int total)
        => total > 0 ? value * 100d / total : 0;

    private static string CssPercent(double value)
        => $"{Math.Clamp(value, 0, 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}%";

    private static string FormatPercent(double value)
        => $"{value.ToString("0", System.Globalization.CultureInfo.InvariantCulture)}%";

    private static string GetYearOnly(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return "";
        var trimmed = value.Trim();
        if (trimmed.Length >= 4 && int.TryParse(trimmed[..4], out var year) && year is >= 1800 and <= 2200)
            return trimmed[..4];

        return "";
    }

    public void Dispose()
    {
        Watchlist.OnStateChanged -= HandleStateChanged;
    }

    private sealed record RatingBucket(string Label, string ShortLabel, int Lower, int Upper, int Count);
    private sealed record RatingBand(string Name, string Range, int Count);
    private sealed record NamedMovie(string Name, WatchlistItem Movie);
    private sealed record TasteInsight(string Name, int Count, int RatedCount, double? AverageRating, int ReactionCount, double LikePercent);
    private sealed record YearActivityInsight(int Year, int Count, int ActiveMonths, double MonthlyAverage, string BusiestMonth);
    private sealed record ReactionStatusInsight(string Name, int Total, int Liked, int Disliked, int Unmarked);

    private enum StatsSection
    {
        Activity,
        Ratings,
        Reactions,
        Genres,
        Directors,
        Profile
    }
}
