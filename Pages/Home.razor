                    </button>
                </div>
            </div>

            <div class="home-chart-scroll mt-2">
                @{ var maxMonth = MoviesPerMonth.Any() ? MoviesPerMonth.Max(x => x.Value) : 0; }
                <div class="home-activity-chart" role="img" aria-label="Monthly watched activity for @SelectedYear">
                    @foreach (var month in MoviesPerMonth)
                    {
                        var height = maxMonth > 0 ? month.Value * 100d / maxMonth : 0;
                        <div class="home-activity-column" title="@month.Key @SelectedYear: @month.Value marked watched">
                            <div class="home-activity-count">@(month.Value > 0 ? month.Value.ToString() : "")</div>
                            <div class="home-activity-track">
                                <div class="home-activity-bar @(month.Value == 0 ? "empty" : "")" style="height:@CssPercent(height);"></div>
                            </div>
                            <div class="home-chart-label">@month.Key</div>
                        </div>
                    }
                </div>
            </div>
        </div>
        </div>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-12 col-lg-7">
                <div class="home-stat-card">
                    <div class="d-flex justify-content-between align-items-start gap-3">
                        <div>
                            <h2 class="home-card-title"><i class="bi bi-star-fill me-2" style="color:#f59e0b;"></i>Rating distribution</h2>
                            <div class="home-card-subtitle">How your ratings are spread across watched titles. Select a range to open it in the library.</div>
                        </div>
                        <button type="button" class="home-see-more" @onclick='() => OpenExpandedStats(StatsSection.Ratings)'>
                            See more <i class="bi bi-arrows-angle-expand" aria-hidden="true"></i>
                        </button>
                    </div>

                    <div class="home-rating-summary">
                        <div>
                            <strong style="color:@Visuals.GetRatingColor(AvgRating);">@(RatedCount > 0 ? AvgRating.ToString("0.0") : "—")</strong>
                            <span>Average</span>
                        </div>
                        <div>
                            <strong style="color:@Visuals.GetRatingColor(MedianRating);">@(RatedCount > 0 ? MedianRating.ToString("0.0") : "—")</strong>
                            <span>Median</span>
                        </div>
                        <div>
                            <strong>@RatingCoveragePercent%</strong>
                            <span>@RatedCount of @WatchedCount rated</span>
                        </div>
                    </div>

                    @if (RatedCount > 0)
                    {
                        var maxRatingBucket = RatingDistribution.Max(x => x.Count);
                        <div class="home-histogram" role="group" aria-label="Rating distribution">
                            @foreach (var bucket in RatingDistribution)
                            {
                                var height = maxRatingBucket > 0 ? bucket.Count * 100d / maxRatingBucket : 0;
                                <button class="home-histogram-column cursor-pointer"
                                        title="@bucket.Label: @bucket.Count titles"
                                        aria-label="@bucket.Label, @bucket.Count titles. Open in library."
                                        disabled="@(bucket.Count == 0)"
                                        @onclick="() => OpenRatingRange(bucket.Lower, bucket.Upper)">
                                    <span class="home-histogram-count">@(bucket.Count > 0 ? bucket.Count.ToString() : "")</span>
                                    <span class="home-histogram-track">
                                        <span class="home-histogram-fill" style="height:@CssPercent(height);background:@Visuals.GetRatingColor(bucket.Upper);"></span>
                                    </span>
                                    <span class="home-histogram-label">@bucket.ShortLabel</span>
                                </button>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="home-empty">Rate watched titles to see their distribution.</div>
                    }
                </div>
            </div>

            <div class="col-12 col-lg-5">
                <div class="home-stat-card">
                    <div class="d-flex justify-content-between align-items-start gap-3">
                        <div>
                            <h2 class="home-card-title"><i class="bi bi-hand-thumbs-up-fill me-2" style="color:#22c55e;"></i>Reactions</h2>
                            <div class="home-card-subtitle">Likes and dislikes across your whole library.</div>
                        </div>
                        <button type="button" class="home-see-more" @onclick='() => OpenExpandedStats(StatsSection.Reactions)'>
                            See more <i class="bi bi-arrows-angle-expand" aria-hidden="true"></i>
                        </button>
                    </div>

                    <div class="home-reaction-bar" role="img" aria-label="@LikedCount liked, @DislikedCount disliked, @UnmarkedCount unmarked">
                        @if (LikedCount > 0)
                        {
                            <div class="home-reaction-liked" style="width:@CssPercent(LikePercentage);" title="Liked: @LikedCount (@FormatPercent(LikePercentage))"></div>
                        }
                        @if (DislikedCount > 0)
                        {
                            <div class="home-reaction-disliked" style="width:@CssPercent(DislikePercentage);" title="Disliked: @DislikedCount (@FormatPercent(DislikePercentage))"></div>
                        }
                        @if (UnmarkedCount > 0)
                        {
                            <div class="home-reaction-unmarked" style="width:@CssPercent(UnmarkedPercentage);" title="Unmarked: @UnmarkedCount (@FormatPercent(UnmarkedPercentage))"></div>
                        }
                    </div>

                    <div class="home-reaction-list">
                        <div class="home-reaction-row">
                            <span class="home-reaction-dot home-reaction-liked"></span>
                            <span class="home-reaction-name">Liked</span>
                            <span class="home-reaction-number">@LikedCount <small>@FormatPercent(LikePercentage)</small></span>
                        </div>
                        <div class="home-reaction-row">
                            <span class="home-reaction-dot home-reaction-disliked"></span>
                            <span class="home-reaction-name">Disliked</span>
                            <span class="home-reaction-number">@DislikedCount <small>@FormatPercent(DislikePercentage)</small></span>
                        </div>
                        <div class="home-reaction-row">
                            <span class="home-reaction-dot home-reaction-unmarked"></span>
                            <span class="home-reaction-name">No reaction</span>
                            <span class="home-reaction-number">@UnmarkedCount <small>@FormatPercent(UnmarkedPercentage)</small></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-12 col-lg-6">
                <div class="home-stat-card">
                    <div class="d-flex justify-content-between align-items-start gap-3">
                        <div>
                            <h2 class="home-card-title"><i class="bi bi-tags-fill me-2" style="color:#6366f1;"></i>Most watched genres</h2>
                            <div class="home-card-subtitle">Volume, average rating, and like rate among reacted titles. Select a genre to open it in Watched.</div>
                        </div>
                        <button type="button" class="home-see-more" @onclick='() => OpenExpandedStats(StatsSection.Genres)'>
                            See more <i class="bi bi-arrows-angle-expand" aria-hidden="true"></i>
                        </button>
                    </div>

                    @if (GenreInsights.Any())
                    {
                        var maxGenreCount = GenreInsights.Max(x => x.Count);
                        <div class="home-insight-list">
                            @foreach (var genre in GenreInsights)
                            {
                                <div class="home-insight-row">
                                    <div class="home-insight-heading">
                                        <button class="home-insight-name text-start" title="Open @genre.Name in Watched" @onclick="() => OpenGenre(genre.Name)">@genre.Name</button>
                                        <span class="home-insight-values">
                                            <strong>@genre.Count</strong> watched
                                            @if (genre.RatedCount > 0)
                                            {
                                                <span> · <strong style="color:@Visuals.GetRatingColor(genre.AverageRating ?? 0);">@(genre.AverageRating?.ToString("0.0"))</strong> avg (@genre.RatedCount)</span>
                                            }
                                            @if (genre.ReactionCount > 0)
                                            {
                                                <span> · @(genre.LikePercent.ToString("0"))% liked</span>
                                            }
                                        </span>
                                    </div>
                                    <div class="home-progress-track"><div class="home-progress-fill" style="width:@CssPercent(genre.Count * 100d / maxGenreCount);"></div></div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="home-empty">No watched genre data is available.</div>
                    }
                </div>
            </div>

            <div class="col-12 col-lg-6">
                <div class="home-stat-card">
                    <div class="d-flex justify-content-between align-items-start gap-3">
                        <div>
                            <h2 class="home-card-title"><i class="bi bi-person-video2 me-2" style="color:#0ea5e9;"></i>Most watched directors</h2>
                            <div class="home-card-subtitle">Counts, rating samples, and like rates among reacted titles are shown together.</div>
                        </div>
                        <button type="button" class="home-see-more" @onclick='() => OpenExpandedStats(StatsSection.Directors)'>
                            See more <i class="bi bi-arrows-angle-expand" aria-hidden="true"></i>
                        </button>
                    </div>

                    @if (DirectorInsights.Any())
                    {
                        var maxDirectorCount = DirectorInsights.Max(x => x.Count);
                        <div class="home-insight-list">
                            @foreach (var director in DirectorInsights)
                            {
                                <div class="home-insight-row">
                                    <div class="home-insight-heading">
                                        <a href="@GetPersonNameUrl(director.Name)"
                                           class="home-insight-name director-link"
                                           title="Open @director.Name"
                                           @onclick:preventDefault="true"
                                           @onclick="() => NavManager.NavigateTo(GetPersonNameUrl(director.Name))">@director.Name</a>
                                        <span class="home-insight-values">
                                            <strong>@director.Count</strong> watched
                                            @if (director.RatedCount > 0)
                                            {
                                                <span> · <strong style="color:@Visuals.GetRatingColor(director.AverageRating ?? 0);">@(director.AverageRating?.ToString("0.0"))</strong> avg (@director.RatedCount)</span>
                                            }
                                            @if (director.ReactionCount > 0)
                                            {
                                                <span> · @(director.LikePercent.ToString("0"))% liked</span>
                                            }
                                        </span>
                                    </div>
                                    <div class="home-progress-track"><div class="home-progress-fill" style="width:@CssPercent(director.Count * 100d / maxDirectorCount);background:linear-gradient(90deg,#38bdf8,#0ea5e9);"></div></div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="home-empty">No watched director data is available.</div>
                    }
                </div>
            </div>
